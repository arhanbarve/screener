# Copy to .env and fill in. .env is gitignored and must never be committed.

# ── Screener (required) ──────────────────────────────────────────────────────
# Free key: https://finnhub.io
FINNHUB_API_KEY=your_key_here
# The SEC requires a real contact string and rate-limits anonymous traffic.
# Use your own name and email — no address is baked into the source.
SEC_USER_AGENT=YourName your@email.com

# ── News overlay (optional) ──────────────────────────────────────────────────
# Without this the Stage 4.5 overlay is skipped; the run still produces a full
# ranked list, minus the entry_signal column.
OPENAI_API_KEY=

# ── Paper trading (optional) ─────────────────────────────────────────────────
# Alpaca paper credentials: https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Set to 1 to make every order/close call a no-op that logs instead of trading.
TRADER_DRY_RUN=1

# ── Email notifications (optional) ───────────────────────────────────────────
# Gmail address plus an app password (not your account password).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
TRADER_EMAIL_TO=

# ── Cloud dashboard (optional; only needed for a hosted deploy) ──────────────
# This repo is public and carries no holdings. A hosted dashboard reads them
# from a private companion repo instead — see src/datastore.py. Locally the
# files are on disk and neither of these is used.
# Token needs read access to that repo only.
DATA_REPO_TOKEN=
DATA_REPO=arhanbarve/screener-data
# Gates the whole app. Unset = no gate, which is right locally and wrong on a
# public URL. Set this on any hosted deploy.
APP_PASSWORD=

# ── Run metadata (optional) ──────────────────────────────────────────────────
# A label recorded in run_status.json. Deliberately not the real hostname,
# which would disclose your network and machine.
SCREENER_HOST_LABEL=screener
