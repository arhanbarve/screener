+def _jsonable(v):
+    """JSON-safe scalar: NaN/NaT -> None, numpy scalars -> Python."""
+    if v is None:
+        return None
+    if isinstance(v, float) and math.isnan(v):
+        return None
+    if hasattr(v, "item"):          # numpy scalar
+        v = v.item()
+        if isinstance(v, float) and math.isnan(v):
+            return None
+        return v
+    if isinstance(v, pd.Timestamp):
+        return v.isoformat()
+    return v
+
